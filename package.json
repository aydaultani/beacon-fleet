{
  "name": "beacon-fleet",
  "version": "0.1.0",
  "description": "Local mission control for Claude Code agents: fleet dashboard, agent control, and a cross-project ticket system agents write to via MCP.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aydaultani/beacon-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/aydaultani/beacon-fleet/issues"
  },
  "homepage": "https://github.com/aydaultani/beacon-fleet#readme",
  "bin": {
    "beacon-fleet": "bin/beacon-fleet.js"
  },
  "files": [
    "bin",
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:server": "tsx watch src/cli.ts",
    "dev:web": "pnpm --filter @beacon-fleet/web dev",
    "build:web": "pnpm --filter @beacon-fleet/web build && rm -rf public && cp -r web/dist public",
    "build:server": "tsup src/cli.ts --format esm --target node22 --out-dir dist --clean",
    "build": "pnpm run build:web && pnpm run build:server",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node bin/beacon-fleet.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.223",
    "@anthropic-ai/sdk": "^0.93.0",
    "@fastify/static": "^8.0.0",
    "@fastify/websocket": "^11.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.0.0",
    "open": "^10.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
