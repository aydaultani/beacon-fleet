# Beacon's own runtime data — never commit
.beacon/
*.db
*.db-journal
*.db-wal

# Anything that could be a Claude Code transcript or config, in case one is
# ever copied in for debugging — never commit
.claude*
*.jsonl
shell-snapshots/

# Node
node_modules/
dist/
web/dist/
/public/
*.log
npm-debug.log*
pnpm-debug.log*

# Env / secrets
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.vscode/
.idea/

# TypeScript
*.tsbuildinfo
